{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mise/event.schema.json",
  "title": "Event and relationship extraction",
  "version": "1.0.0",
  "type": "object",
  "required": ["events", "extraction_confidence"],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "headline", "confidence"],
        "additionalProperties": false,
        "properties": {
          "event_type": {
            "type": "string",
            "enum": ["opening", "closing", "chef_move", "award", "funding", "expansion",
                     "refurbishment", "concept_change", "relocation", "ownership_change",
                     "temporary_closure", "residency", "popup"]
          },
          "headline": { "type": "string", "minLength": 1 },
          "primary_entity_name": { "type": ["string", "null"] },
          "secondary_entity_name": { "type": ["string", "null"] },
          "city": { "type": ["string", "null"] },
          "date_stated": { "type": ["string", "null"], "format": "date" },
          "date_precision": {
            "type": "string",
            "enum": ["exact", "month", "quarter", "year", "inferred"]
          },
          "detail": { "type": ["string", "null"] },
          "amount": { "type": ["number", "null"], "minimum": 0 },
          "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "relationships_implied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_name", "to_name", "rel_type", "confidence"],
        "additionalProperties": false,
        "properties": {
          "from_name": { "type": "string", "minLength": 1 },
          "to_name": { "type": "string", "minLength": 1 },
          "rel_type": {
            "type": "string",
            "enum": ["chef_at", "owned_by", "invested_in", "supplies", "succeeded_by",
                     "spun_off_from", "trained_under", "operates_in", "consults_for"]
          },
          "role_detail": { "type": ["string", "null"] },
          "date_stated": { "type": ["string", "null"], "format": "date" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
