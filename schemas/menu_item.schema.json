{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mise/menu.schema.json",
  "title": "Menu extraction",
  "version": "1.1.0",
  "$comment": "1.1.0 (2026-09-28): D-057 menu_date_stated is free text as printed, not a date; D-059 the extractor never writes name_original / description_original, it writes *_as_extracted and flags machine_unverified.",
  "type": "object",
  "required": ["is_menu"],
  "additionalProperties": false,
  "properties": {
    "is_menu": { "type": "boolean" },
    "venue_name_as_written": { "type": ["string", "null"], "minLength": 1 },
    "city_as_written": { "type": ["string", "null"] },
    "menu_type": {
      "type": ["string", "null"],
      "enum": ["a_la_carte", "tasting", "lunch", "breakfast", "bar", "wine", "dessert", "brunch", "snacks", null]
    },
    "menu_date_stated": { "type": ["string", "null"], "description": "Any date, season, version or validity string exactly as printed. Never used as observed_at unless it is a full date printed on the artefact (D-057)." },
    "menu_date_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "menu_price": { "type": ["number", "null"], "minimum": 0 },
    "language": { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_name", "items"],
        "additionalProperties": false,
        "properties": {
          "section_name": { "type": "string" },
          "items": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "required": ["name_as_extracted", "name_original_transcription", "confidence"],
              "additionalProperties": false,
              "properties": {
                "name_as_extracted": { "type": "string", "minLength": 1 },
                "name_original_transcription": { "type": "string", "enum": ["machine_unverified"] },
                "name_original": { "type": "null", "description": "Always null from the extractor. Filled only by human transcription (D-059)." },
                "name_translated": { "type": ["string", "null"] },
                "description_as_extracted": { "type": ["string", "null"] },
                "description_original": { "type": "null" },
                "description_translated": { "type": ["string", "null"] },
                "price": { "type": ["number", "null"], "minimum": 0 },
                "position": { "type": ["integer", "null"], "minimum": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "notes_visible_on_menu": { "type": ["string", "null"] },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "fields_uncertain": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "is_menu": { "const": true } } },
      "then": { "required": ["venue_name_as_written", "sections", "extraction_confidence"] }
    }
  ]
}
